# Server
PORT=5000
NODE_ENV=development

# Database
# Point at a single-node replica set — multi-collection writes use transactions,
# which a standalone mongod cannot serve. See the README for the one-time setup.
MONGODB_URI=mongodb://localhost:27017/hospital_management

# Auth
JWT_SECRET=CHANGE_THIS_SECRET
JWT_EXPIRES_IN=1d

# Frontend
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of the API, for client-IP resolution
# (rate limiting, audit logs). 1 for the bundled nginx; 0 when exposed directly.
# Never set this higher than the number of proxies you actually control —
# each extra hop is one the client could forge.
TRUST_PROXY=0

# File storage: 'local' (disk). S3/GCS can be added behind the same interface.
STORAGE_DRIVER=local

# Logging level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=info

# --- V3: Multi-tenancy (DB-per-tenant) ---
# Control database holding the tenant registry.
CONTROL_DB=hms_control
# Tenant resolution: 'header' (dev: X-Tenant header) or 'subdomain'.
TENANCY_MODE=header
# Base domain for subdomain mode (apollo.hms.local → tenant "apollo").
BASE_DOMAIN=hms.local
# Fallback tenant + its DB (defaults to the existing app DB — no migration needed).
DEFAULT_TENANT_SLUG=default
# DEFAULT_TENANT_DB=hospital_management   # derived from MONGODB_URI if unset

# --- V2: Email channel (optional; dev logs to console when unset) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=HMS <no-reply@hospital.example>

# --- V2: SMS channel (optional; dev logs to console when unset) ---
# SMS_PROVIDER=twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# --- V2: Online payments (Razorpay; mock mode when unset) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Default seed admin (used only by seed script)
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=Admin@123
