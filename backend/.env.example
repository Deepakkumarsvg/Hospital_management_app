# Server
PORT=5000
NODE_ENV=development

# Database
# Point at a single-node replica set — multi-collection writes use transactions,
# which a standalone mongod cannot serve. See the README for the one-time setup.
MONGODB_URI=mongodb://localhost:27017/hospital_management

# Auth
JWT_SECRET=CHANGE_THIS_SECRET
JWT_EXPIRES_IN=1d

# Frontend
CLIENT_URL=http://localhost:5173

# Number of reverse proxies in front of the API, for client-IP resolution
# (rate limiting, audit logs). 1 for the bundled nginx; 0 when exposed directly.
# Never set this higher than the number of proxies you actually control —
# each extra hop is one the client could forge.
TRUST_PROXY=0

# File storage driver: 'local' (disk under backend/uploads) or 's3'.
#
# Use 's3' on any host with an ephemeral filesystem (Render, Fly, Heroku) —
# otherwise every uploaded patient document is deleted on the next deploy.
# Works with AWS S3, Cloudflare R2, Backblaze B2 or MinIO.
STORAGE_DRIVER=local

# Required when STORAGE_DRIVER=s3 (server refuses to boot without them).
# S3_BUCKET=hms-uploads
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto
# Set for R2 / B2 / MinIO; leave unset for AWS S3 itself.
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# Logging level (fatal|error|warn|info|debug|trace)
LOG_LEVEL=info

# --- Error tracking ---
#
# The self-hosted half is always on: 5xx responses, browser crashes and slow
# requests are grouped into the ErrorLog collection and shown at /errors in the
# app. Nothing below is required for that.
#
# How long a failure is kept after its LAST occurrence. 0 keeps them forever.
ERROR_RETENTION_DAYS=30

# A request slower than this (ms) is recorded as a defect of its own. 0 is off.
SLOW_REQUEST_MS=3000

# Same for individual database queries — this is how a missing index announces
# itself. Off by default: the hooks run on every query in the app, so leaving
# it on is a decision rather than a default. Switch it on when hunting a
# specific slowdown.
# SLOW_QUERY_MS=500

# Sentry (optional) — the other half: alerts within seconds, breadcrumbs, and
# reports that still arrive when the process is too broken to reach MongoDB.
# Free tier covers a hospital of this size. Leave unset to run self-hosted only.
# SENTRY_DSN=https://<key>@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# How many crash reports one browser may post in five minutes. The browser
# deduplicates before this; the budget is the backstop against a render loop
# that throws on every frame.
# ERROR_REPORT_RATE_LIMIT=30

# Which build this is. Injected automatically on Render/Vercel/Railway/Heroku
# and in GitHub Actions — set it only if you build and tag images yourself.
# APP_RELEASE=

# --- V3: Multi-tenancy (DB-per-tenant) ---
# Control database holding the tenant registry.
CONTROL_DB=hms_control
# Tenant resolution: 'header' (dev: X-Tenant header) or 'subdomain'.
TENANCY_MODE=header
# Base domain for subdomain mode (apollo.hms.local → tenant "apollo").
BASE_DOMAIN=hms.local
# Fallback tenant + its DB (defaults to the existing app DB — no migration needed).
DEFAULT_TENANT_SLUG=default
# DEFAULT_TENANT_DB=hospital_management   # derived from MONGODB_URI if unset

# --- V2: Email channel (optional; dev logs to console when unset) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=HMS <no-reply@hospital.example>

# --- V2: SMS channel (optional; dev logs to console when unset) ---
# SMS_PROVIDER=twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_FROM=

# --- V2: Online payments (Razorpay; mock mode when unset) ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Default seed admin (used only by seed script)
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=Admin@123
