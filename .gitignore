# Dependencies
node_modules/
.pnp
.pnp.js

# Builds
dist/
build/
*.tsbuildinfo

# Environment / secrets — NEVER commit these (templates *.example are tracked)
.env
.env.local
.env.*.local
.env.development
.env.production
# A developer's own login to a live hospital, used by scripts/fetch-errors.mjs.
.env.errors

# MongoDB replica-set key file — a shared secret, generated per deployment by
# scripts/mongo-keyfile.sh. Back it up with the database; never commit it.
secrets/

# Uploaded files / user data (local storage driver)
backend/uploads/
uploads/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/

# Test / coverage
coverage/
.nyc_output/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# Misc
.cache/
tmp/

# Errors pulled from production by `npm run errors`. A snapshot of a live
# hospital — stack traces, request ids, who hit what — that is stale within
# minutes. Re-run the command; never commit the output.
.errors/
