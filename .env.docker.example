# Copy to `.env` (same folder as docker-compose.yml) before `docker compose up`.
# docker compose reads this file automatically for ${VAR} substitution.
#
# First-run checklist:
#   1. cp .env.docker.example .env
#   2. fill in the REQUIRED values below
#   3. sh scripts/mongo-keyfile.sh        # replica-set internal auth key
#   4. docker compose up -d --build

# REQUIRED — generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# REQUIRED — the database runs with authentication enabled; this is the account
# the API connects as. Without it anything that can reach the container has
# unrestricted access to every hospital's records.
MONGO_ROOT_USER=hms_root
MONGO_ROOT_PASSWORD=

# Access tokens are short-lived on purpose. Signing out, changing a password
# and an admin revoking a session all work through the refresh session instead,
# which is a real database row and can actually be cancelled.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# Public origin the browser will use (must match how you open the app).
CLIENT_URL=http://localhost:8080

# How long audit entries are kept. 0 disables expiry (keep forever).
# Default is ~7 years, which is the usual floor for clinical access records.
AUDIT_RETENTION_DAYS=2555

# How long captured errors are kept after their last occurrence. Much shorter
# than the audit trail on purpose: a bug nobody has hit in a month is either
# fixed or not worth the row.
ERROR_RETENTION_DAYS=30

# A request slower than this (ms) is recorded as a defect. 0 turns it off.
SLOW_REQUEST_MS=3000

# OPTIONAL — Sentry, for alerting the moment something breaks. Everything works
# without it; the errors are already at /errors inside the app.
# SENTRY_DSN=
# VITE_SENTRY_DSN=   # the browser half — see docs/ERROR_TRACKING.md

# OPTIONAL — encrypts free-text clinical notes at rest (see utils/encryption.js).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# LOSING THIS KEY MAKES THOSE NOTES UNREADABLE. Back it up separately from the
# database — a backup containing both is a backup with the lock and the key.
# PHI_ENCRYPTION_KEY=

# Seed admin (used only by `docker compose exec backend npm run seed`).
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=Admin@123
